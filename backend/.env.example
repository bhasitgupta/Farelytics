# ==============================================================================
# APIx / Farelytics Backend Environment Configuration
# ==============================================================================

# Application & Server
APIX_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO
ROBOTS_CACHE_TTL=86400
PROJECT_NAME="Farelytics / APIx - Real-Time Airfare Price Index"
API_PREFIX="/api"

# Database Settings
# Set SUPABASE_DATABASE_URL to connect to Supabase PostgreSQL.
# If omitted, system defaults transparently to SQLite (apix.db).
DATABASE_URL=sqlite:///./apix.db
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Google OAuth Authentication
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
REQUIRE_AUTH_FOR_MUTATIONS=false

# Calculation Base Period
BASE_PERIOD=2026-08
